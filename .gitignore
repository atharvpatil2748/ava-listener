# ----------------------------------------------------------------------------
# AVA-Listener - Proposed .gitignore
# ----------------------------------------------------------------------------

# 1. Dependency Directories
node_modules/
venv/
env/
.env/

# 2. Python Caches & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# 3. Large Binaries & Models
models/
*.onnx
models_manifest.json

# 4. Runtime State & Logging
temp/
out.log
*.log
crash_dumps/
telemetry_data/

# 5. Build Artifacts & Distribution
*.tgz
*.zip
ava-listener-*.tgz
upload_manifest.json
repo_upload_plan.json

# 6. Local Development Scratchpads & Audits
verification_outputs/
test.js
test.json
test_*.py
PHASE_*.md
*_REPORT.md
*_AUDIT.md
*_CHECKPOINT.md
*proposal.txt
bootstrap.lock
requirements.lock.txt

# 7. OS Generated
.DS_Store
Thumbs.db

# generated verification artifacts
final_npm_pack*.txt
npm_pack_dry_run.txt

# runtime cache
cache/
*.json.tmp

# temporary benchmark outputs
benchmarks/resource_timeline.json