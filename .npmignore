# ----------------------------------------------------------------------------
# AVA-Listener - Proposed .npmignore
# ----------------------------------------------------------------------------
# Rule: Exclude everything not strictly required for the production runtime.

# 1. Developer Tooling & Infrastructure
.github/
scripts/

# 2. Testing & Quality Assurance
tests/
benchmarks/

# 3. Documentation & Examples
docs/
examples/
*.md
!README.md
!CHANGELOG.md
!LICENSE

# 4. Independent Packages
sdk/

# 5. Runtime Artifacts & Caches
temp/
out.log
*.log
models/
models_manifest.json
__pycache__/
*.pyc

# 6. Local Environment (Fallback protection)
node_modules/
venv/

# 7. Local Dev Scratchpads
verification_outputs/
test.js
test.json
test_*.py
*.tgz
*proposal.txt

# Missing from previous pass
upload_manifest.json
repo_upload_plan.json

# Reports
final_npm_pack.txt
final_npm_pack2.txt
npm_pack_dry_run.txt

# Cache
cache/

# Temp
temp/
temp_workflows/
__pycache__/

# Logs
*.log

# Git
.git/
.github/

# Models
models/
*.onnx
*.tar.bz2

# Benchmarks/tests
benchmarks/
tests/